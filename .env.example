PORT=3000
MONGODB_URI=mongodb://localhost:27017/becrm
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
# Comma-separated email domains allowed to use the API at all. Empty disables
# the check entirely. Deploy docs/auth0/restrict-to-trusted-domains.js to the
# tenant BEFORE setting this: without the action there is no email on the access
# token, and the check falls back to a /userinfo call per signed-in user.
ALLOWED_EMAIL_DOMAINS=
# Where that action writes the email. Must match EMAIL_CLAIM in the action.
AUTH0_EMAIL_CLAIM=https://trustedtechnology.ai/email
ADMIN_EMAILS=
# Comma-separated. Who gets the whole hub. Everybody else who can sign in gets
# the Agency Map and the Brevo email agent, and a 403 on every other route.
# Empty falls back to neel@trustedtechnology.ai -- never to everyone.
FULL_ACCESS_EMAILS=
ADMIN_AUTH0_IDS=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=medium
T500_IMAGE_REFERENCE_PATH=./assets/article-images/t500-camera-reference.png
AHREFS_API_KEY=
AHREFS_API_URL=https://api.ahrefs.com/v3
SURFER_API_KEY=
SURFER_API_URL=
SEO_USE_MOCK_AHREFS=false
SEO_USE_MOCK_SURFER=false
SEO_USE_MOCK_LLM=false
SEO_OUTPUT_DIR=./data/seo-content
SEO_MAX_MODEL_RETRIES=1
SEO_REQUEST_TIMEOUT_MS=30000
HERMES_API_URL=
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
HERMES_REQUEST_TIMEOUT_MS=300000
# Preferred production path: App Platform calls the MCP gateway on the Hermes Droplet.
HUBSPOT_DEALS_PROXY_URL=
HUBSPOT_DEALS_PROXY_TOKEN=
HUBSPOT_DEALS_PROXY_TIMEOUT_MS=30000
# Direct HubSpot MCP connection used by the deal-pipeline assistant.
HUBSPOT_MCP_URL=
HUBSPOT_MCP_ACCESS_TOKEN=
# Recommended for production so expired access tokens refresh without a redeploy.
HUBSPOT_MCP_REFRESH_TOKEN=
HUBSPOT_MCP_CLIENT_ID=
HUBSPOT_MCP_CLIENT_SECRET=
HUBSPOT_MCP_TOKEN_URL=
HUBSPOT_MCP_REQUEST_TIMEOUT_MS=25000
# Shared agent memory. Development may use stdio; production must use scoped HTTP MCP tokens.
GBRAIN_ENABLED=false
GBRAIN_MCP_URL=
GBRAIN_MCP_TOKEN=
GBRAIN_MCP_COMMAND=
GBRAIN_MCP_ARGS_JSON=[]
GBRAIN_MCP_CWD=
GBRAIN_HOME=
GBRAIN_SEARCH_LIMIT=6
GBRAIN_REQUEST_TIMEOUT_MS=8000
AHREFS_MCP_ENABLED=false
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Hosted alternative to the file path: the service-account key JSON itself,
# raw or base64 (base64 -i key.json | pbcopy). Wins over the path when both set.
GOOGLE_SERVICE_ACCOUNT_JSON=
GA4_CACHE_TTL_MS=300000
OPENCLAW_BROWSER_PROFILE=openclaw
OPENCLAW_BROWSER_TIMEOUT_MS=30000
# WordPress REST API. Use an Application Password, never the normal account password.
WORDPRESS_URL=https://trustedtechnology.ai
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
WORDPRESS_REQUEST_TIMEOUT_MS=30000
WORDPRESS_ARTICLE_TEMPLATE_ID=1113

# Content Operations: default Ahrefs saved keyword list id the research stage pulls from (see beCRM/.env)
CONTENT_OPS_KEYWORD_LIST_ID=

# Content Operations: Surfer workspace id the optimization stage creates Content Editors in
# (default baked into code as DEFAULT_SURFER_WORKSPACE_ID=1374371). Requires the Surfer OAuth MCP on Hermes.
CONTENT_OPS_SURFER_WORKSPACE_ID=
# Optional: max ms for the Surfer optimize+revise Hermes call (default 480000)
CONTENT_OPS_SURFER_TIMEOUT_MS=
CONTENT_OPS_SURFER_POLL_MS=
CONTENT_OPS_SURFER_MAX_POLLS=
# Content Operations: Surfer target SEO content score the optimization loop aims for (default 90)
CONTENT_OPS_SURFER_TARGET_SCORE=
# Max Surfer revision passes toward the target (default 5)
CONTENT_OPS_SURFER_MAX_PASSES=
# Length check: how far the article may stray from Surfer's target_word_count,
# as a fraction (default 0.15 = ±15%). Drafts outside the band are sent back to
# Hermes for cutting/expansion; this many focused passes at most (default 2).
CONTENT_OPS_WORD_COUNT_TOLERANCE=
CONTENT_OPS_LENGTH_MAX_PASSES=

# --- Sitemap automation ---
# Yoast builds the sitemap; the backend verifies published URLs are in it and
# re-submits it to Google Search Console. Default sitemap: WORDPRESS_URL/sitemap_index.xml.
# The Search Console property is discovered from the properties the service
# account (GOOGLE_APPLICATION_CREDENTIALS) has been added to — add it under
# Settings → Users and permissions with Full permission. Set GSC_SITE_URL only
# to force one (e.g. https://trustedtechnology.ai/ or sc-domain:trustedtechnology.ai).
SITEMAP_URL=
GSC_SITE_URL=
# Poll WordPress for posts published/edited from wp-admin (default true, every 10m).
SITEMAP_WATCH_ENABLED=
SITEMAP_WATCH_INTERVAL_MS=
# Optional IndexNow (Bing/Yandex) key; the key file must be hosted on the site.
INDEXNOW_KEY=
INDEXNOW_KEY_LOCATION=

# --- Hermes desktop UI (Orchestrator tab) ---
# Dashboard the backend proxies onto the Hub's origin. On prod point this at the
# droplet over the VPC, e.g. http://10.124.0.2:9119. Never expose it publicly:
# the dashboard is a terminal, file browser and API-keys page on that droplet.
HERMES_DASHBOARD_URL=
# Signs the short-lived cookie the Orchestrator iframe travels on. Required.
# Rotating it revokes every live session.
HERMES_DASHBOARD_SESSION_SECRET=
# Comma-separated. Fails CLOSED -- empty means nobody gets in. Use a full
# address, or a bare @domain to grant a whole domain.
HERMES_DASHBOARD_ALLOWED_EMAILS=

# --- Hub MCP server (the hub's agents as tools for Hermes Operations) ---
# POST /hub-mcp is an MCP endpoint that exposes list_agents and ask_agent, so
# the Hermes dashboard, its crons and kanban can talk to the hub's agents. The
# caller is the Hermes container, not a person, so it authenticates with this
# bearer key instead of Auth0. Fails CLOSED: unset means the endpoint answers
# nobody. Generate with: openssl rand -hex 32
HUB_MCP_KEY=
# Who memory retrieval and "saved by" stamps see for calls made through the
# MCP. Defaults to hermes-operations@trustedtechnology.ai.
HUB_MCP_ACTOR_EMAIL=

# Per-person Gmail (Agency Map: Connect Gmail, voicemail follow-up, inbox).
# Web application OAuth client from Google Cloud Console, Internal to the
# Workspace, with GOOGLE_OAUTH_REDIRECT_URI registered as a redirect URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/gmail/callback
# 32+ random characters; encrypts each person's stored refresh token.
GMAIL_TOKEN_KEY=
# Where the browser returns to after Google consent.
HUB_FRONTEND_URL=http://localhost:5173

# "off" stops this backend driving the daily research morning (it still reads
# the board). Leave unset in production.
DAILY_RESEARCH_SCHEDULER=
